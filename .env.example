# ==============================================================================
# Discovery Engine - Environment Variable Template
# Copy this file to .env and fill in the secret values.
# NEVER COMMIT .env TO VERSION CONTROL.
# ==============================================================================

# Fleet Worker API Authentication
SERVICE_AUTH_TOKEN="your_secure_random_token_here"

# Google Cloud Service Account (Raw JSON string or path)
GOOGLE_SERVICE_ACCOUNT_JSON='{"type": "service_account", "project_id": "...", "private_key_id": "...", "private_key": "...", "client_email": "...", "client_id": "..."}'
GOOGLE_BACKUP_SERVICE_ACCOUNT_JSON=''

# Gemini LLM Credentials
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"
GEMINI_TOKEN="AIzaSyYourGeminiApiKeyHere"

# Tracxn API Credentials (Comma-separated for multi-token rotation)
TRACXN_API_TOKEN="your_primary_tracxn_token"
TRACXN_API_TOKENS="token1,token2,token3"

# Fleet Public Hostname Domain
FLEET_DOMAIN="rajath.world"

# Cloudflare Tunnel Tokens (per desktop)
TUNNEL_TOKEN_VISHNU=""
TUNNEL_TOKEN_5321=""
TUNNEL_TOKEN_5080=""

# Nvidia NIM LLM Credentials (Comma-separated)
NIM_API_KEYS="nvapi-key1,nvapi-key2"
NVIDIA_BASE_MODEL="meta/llama-3.1-70b-instruct"
NVIDIA_ENDPOINT="https://integrate.api.nvidia.com/v1"

# Concurrency & Batch Sizes
MAX_WORKERS=10
BATCH_SIZE=10

# Google Sheets Configuration
CONFIG_SHEET_ID=""
IF_SHEET_ID=""
IF_EXTRACTING_SHEET_NAME=""
CF_EXTRACTING_SHEET_NAME=""
SHEET1_ID=""
SHEET1_PORT=8769
SHEET2_ID=""
SHEET2_PORT=8770
SHEET3_ID=""
SHEET3_PORT=8771
SHEET4_ID=""
SHEET4_PORT=8772
DISCOVERY_PORT=8769
CF_SHEET_ID=""
